{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanban",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // https://kanban.skyhawklabs.dev (skyhawklabs.dev must be a zone in this Cloudflare account)
  "routes": [{ "pattern": "kanban.skyhawklabs.dev", "custom_domain": true }],
  "workers_dev": false,

  // Supabase Postgres through Hyperdrive. Create it with:
  //   npx wrangler hyperdrive create kanban-db --connection-string="<Supabase direct connection string>"
  // and paste the returned id here. For `npm run dev`, set
  //   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<a Postgres URL>
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],

  // Hourly; runDueReminders only sends once it's past REMINDER_HOUR in REMINDER_TIMEZONE
  "triggers": { "crons": ["17 * * * *"] },

  // Shared rate limits (period must be 10 or 60 seconds)
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } },
    { "name": "OPENAI_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],

  // Non-secret configuration. Secrets (SESSION_SECRET, SENDGRID_API_KEY, FROM_EMAIL,
  // OPENAI_API_KEY, RECAPTCHA_SECRET_KEY, CRON_SECRET, ADMIN_APPROVAL_SECRET,
  // SUPABASE_SECRET_KEY, optional REALTIME_TOPIC_SECRET) are set with
  // `wrangler secret put <NAME>`. FROM_EMAIL must be a verified SendGrid sender.
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://kanban.skyhawklabs.dev",
    "ADMIN_EMAIL": "brad@vanskyhawk.com",
    "SIGNUP_MODE": "invite_only",
    "SIGNUP_REQUIRE_APPROVAL": "true",
    "REMINDER_TIMEZONE": "America/Los_Angeles",
    "REMINDER_HOUR": "8",

    // Live board updates (Supabase Realtime Broadcast). Both values are public: they're
    // sent to browsers. Also set the SUPABASE_SECRET_KEY secret. Leave empty to disable
    // (shared boards then fall back to polling every 30s).
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": ""
  }
}
