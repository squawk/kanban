# Session Secret (REQUIRED in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here

# Admin Approval Secret (optional, defaults to SESSION_SECRET)
ADMIN_APPROVAL_SECRET=your_admin_approval_secret_here

# OpenAI API Key for AI prompt generation
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# SendGrid for email (verification, invitations, assignment/comment notifications).
# Without it, emails are logged to the console in development and skipped in production.
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@example.com

# Public URL used in email links
APP_URL=http://localhost:5173

# Admin bootstrap: these addresses (comma-separated) are always admins, can always
# register (even when sign-up is closed), and skip approval. Manage everyone else in /admin.
ADMIN_EMAIL=admin@example.com

# Default sign-up policy until an admin changes it in Admin → Sign-up
#   open        - anyone can register
#   domain      - only emails at SIGNUP_ALLOWED_DOMAINS (subdomains included)
#   invite_only - self sign-up closed; admins invite people
SIGNUP_MODE=open
SIGNUP_ALLOWED_DOMAINS=
# Set to "false" to auto-approve new sign-ups (they still verify their email)
SIGNUP_REQUIRE_APPROVAL=true

# Google reCAPTCHA (for signup spam prevention)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Database Path (set by Fly.io volume in production)
# For local development, leave unset (uses ./data.db)
# DATABASE_PATH=/data/data.db
